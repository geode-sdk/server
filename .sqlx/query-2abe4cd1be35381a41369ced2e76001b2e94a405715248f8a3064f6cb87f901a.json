  "query": "SELECT\n            m.id, m.repository, NULL as about, NULL as changelog, m.featured,\n            m.download_count, m.created_at, m.updated_at,\n            ms.status AS \"status: _\", NULL AS status_info\n        FROM mods m\n        INNER JOIN mod_statuses ms ON ms.mod_id = m.id\n        WHERE m.id = $1",
